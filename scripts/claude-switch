#!/bin/bash
# =============================================================================
# claude-switch — Multi-account switcher for Claude Code on macOS
# =============================================================================
#
# Stores OAuth tokens for unlimited accounts in the macOS Keychain and injects
# the right one into the entry Claude Code reads at launch.
# Profile metadata (subscription labels) stored as JSON in a separate entry.
# Everything lives in the Keychain, nothing on disk.
#
# Usage:
#   claude-switch setup [N]      — Capture current Keychain token for a profile
#   claude-switch N [args...]    — Launch Claude Code with chosen profile
#   claude-switch status         — Show profile status
#   claude-switch export N       — Display a token (debug)
#   claude-switch clean          — Remove claude-switch entries from Keychain
#
# Installation:
#   ./scripts/install.sh
#
# Recommended aliases (~/.zshrc):
#   alias cc1="claude-switch 1"
#   alias cc2="claude-switch 2"
#
# =============================================================================

set -euo pipefail

VERSION="0.0.2"

CC_SERVICE="Claude Code-credentials"
PREFIX="claude-switch"
META_SERVICE="${PREFIX}-meta"
ACCOUNT="$USER"
CLAUDE_BIN="${CLAUDE_BIN:-claude}"

RED=$'\033[0;31m' GREEN=$'\033[0;32m' YELLOW=$'\033[1;33m'
BLUE=$'\033[0;34m' CYAN=$'\033[0;36m' DIM=$'\033[2m' NC=$'\033[0m'

info()  { echo "${BLUE}ℹ${NC}  $*"; }
ok()    { echo "${GREEN}✓${NC}  $*"; }
warn()  { echo "${YELLOW}⚠${NC}  $*"; }
error() { echo "${RED}✗${NC}  $*" >&2; }

svc() {
    [[ "$1" =~ ^[1-9][0-9]*$ ]] || { error "Profile must be a positive integer"; exit 1; }
    echo "${PREFIX}-profile-$1"
}

kc_read()   { security find-generic-password -s "$1" -a "$ACCOUNT" -w 2>/dev/null || echo ""; }
kc_write()  { security delete-generic-password -s "$1" -a "$ACCOUNT" 2>/dev/null || true
              security add-generic-password -s "$1" -a "$ACCOUNT" -w "$2" -U 2>/dev/null; }
kc_delete() { security delete-generic-password -s "$1" -a "$ACCOUNT" 2>/dev/null || true; }

# --- Meta registry -----------------------------------------------------------
# JSON stored in Keychain: {"1":"Pro","2":"Max 5x",...}

meta_read() {
    local raw; raw=$(kc_read "$META_SERVICE")
    [[ -z "$raw" ]] && echo "{}" || echo "$raw"
}

meta_write() {
    kc_write "$META_SERVICE" "$1"
}

meta_set() {
    local num="$1" label="$2"
    local updated; updated=$(python3 -c "
import json,sys
d=json.loads(sys.argv[1]); d[sys.argv[2]]=sys.argv[3]
print(json.dumps(d,separators=(',',':')))" "$(meta_read)" "$num" "$label")
    meta_write "$updated"
}

meta_remove() {
    local num="$1"
    local updated; updated=$(python3 -c "
import json,sys
d=json.loads(sys.argv[1]); d.pop(sys.argv[2],None)
print(json.dumps(d,separators=(',',':')))" "$(meta_read)" "$num")
    meta_write "$updated"
}

meta_next() {
    python3 -c "
import json,sys
d=json.loads(sys.argv[1]); nums=[int(k) for k in d]
n=1
while n in nums: n+=1
print(n)" "$(meta_read)"
}

meta_profiles() {
    python3 -c "
import json,sys
d=json.loads(sys.argv[1]); print(' '.join(str(k) for k in sorted(int(x) for x in d)))" "$(meta_read)"
}

meta_get_label() {
    python3 -c "
import json,sys
d=json.loads(sys.argv[1]); print(d.get(sys.argv[2],''))" "$(meta_read)" "$1"
}

# --- Token helpers ------------------------------------------------------------

token_preview() {
    python3 -c "
import json,sys,datetime
try:
    d=json.loads(sys.stdin.read());o=d.get('claudeAiOauth',{})
    at=o.get('accessToken','');exp=o.get('expiresAt',0)
    e=datetime.datetime.fromtimestamp(exp/1000).strftime('%Y-%m-%d %H:%M') if exp else 'N/A'
    print(f'{at[:25]}...  expires: {e}')
except: print('(unrecognized format)')
" <<< "$1" 2>/dev/null || echo "${1:0:30}..."
}

detect_plan() {
    python3 -c "
import json,sys,base64
LABELS={
    'free':'Free','pro':'Pro','max_5x':'Max 5x','max_20x':'Max 20x',
    'team':'Team','enterprise':'Enterprise','education':'Education',
    'max5x':'Max 5x','max20x':'Max 20x',
}
def match(v):
    if not isinstance(v,str): return ''
    k=v.lower().replace(' ','_').replace('-','_')
    return LABELS.get(k,'')

def scan(obj):
    for field in ('planType','plan','tier','subscription','membershipType','plan_type','account_type'):
        v=obj.get(field,'')
        m=match(v)
        if m: return m
    return ''

try:
    d=json.loads(sys.argv[1])
    o=d.get('claudeAiOauth',{})
    r=scan(o)
    if r: print(r); sys.exit(0)
    # try JWT decode of accessToken
    at=o.get('accessToken','')
    if at:
        parts=at.split('.')
        if len(parts)>=2:
            payload=parts[1]
            payload+='='*(-len(payload)%4)
            claims=json.loads(base64.b64decode(payload))
            r=scan(claims)
            if r: print(r); sys.exit(0)
    print('')
except:
    print('')
" "$1" 2>/dev/null
}

# --- Commands -----------------------------------------------------------------

cmd_setup() {
    local num
    if [[ -n "${1:-}" ]]; then
        num="$1"
        # validate
        [[ "$num" =~ ^[1-9][0-9]*$ ]] || { error "Profile must be a positive integer"; exit 1; }
    else
        num=$(meta_next)
        info "Auto-assigning profile ${CYAN}$num${NC}"
    fi

    local s; s=$(svc "$num")
    info "Reading token from Keychain..."
    local t; t=$(kc_read "$CC_SERVICE")
    [[ -z "$t" ]] && { error "No token found. Run claude → /login → quit, then run setup again."; exit 1; }
    info "$(token_preview "$t")"

    # detect subscription
    local detected; detected=$(detect_plan "$t")
    local label=""
    if [[ -n "$detected" ]]; then
        info "Detected subscription: ${CYAN}${detected}${NC}"
        read -rp "  Label [${detected}]: " user_label
        label="${user_label:-$detected}"
    else
        read -rp "  Subscription label (e.g. Pro, Max 5x, Team): " label
        [[ -z "$label" ]] && label="unknown"
    fi

    kc_write "$s" "$t"
    meta_set "$num" "$label"
    ok "Token saved for profile ${CYAN}$num${NC} (${label})"
}

cmd_run() {
    local p="$1"; shift
    local s; s=$(svc "$p")
    local t; t=$(kc_read "$s")
    [[ -z "$t" ]] && { error "Profile $p not configured. Run: claude-switch setup $p"; exit 1; }

    local label; label=$(meta_get_label "$p")
    local display="$p"
    [[ -n "$label" ]] && display="$p (${label})"

    info "Activating profile ${CYAN}${display}${NC}"
    kc_write "$CC_SERVICE" "$t"
    ok "Token injected"
    echo ""

    local cd="$HOME/.claude-profile-${p}"; mkdir -p "$cd"
    CLAUDE_CONFIG_DIR="$cd" "$CLAUDE_BIN" "$@"
    local rc=$?

    local r; r=$(kc_read "$CC_SERVICE")
    if [[ -n "$r" && "$r" != "$t" ]]; then
        kc_write "$s" "$r"
        ok "Refreshed token saved (profile $p)"
    fi
    return $rc
}

cmd_status() {
    echo ""
    local cur; cur=$(kc_read "$CC_SERVICE")
    local profiles; profiles=$(meta_profiles)

    if [[ -z "$profiles" ]]; then
        # check for legacy profiles (1, 2) without meta
        local found_legacy=false
        for p in 1 2; do
            local s; s=$(svc "$p"); local t; t=$(kc_read "$s")
            if [[ -n "$t" ]]; then
                if ! $found_legacy; then
                    warn "Found legacy profiles (no labels). Run setup again to add labels."
                    found_legacy=true
                fi
                local a=""; [[ -n "$cur" && "$t" == "$cur" ]] && a=" ${GREEN}← ACTIVE${NC}"
                ok "Profile $p${a}"
                echo -e "     ${DIM}$(token_preview "$t")${NC}"
            fi
        done
        if ! $found_legacy; then
            info "No profiles configured. Run: claude-switch setup"
        fi
    else
        for p in $profiles; do
            local s; s=$(svc "$p"); local t; t=$(kc_read "$s")
            local label; label=$(meta_get_label "$p")
            if [[ -n "$t" ]]; then
                local a=""; [[ -n "$cur" && "$t" == "$cur" ]] && a=" ${GREEN}← ACTIVE${NC}"
                local lbl=""; [[ -n "$label" ]] && lbl=": ${label}"
                ok "Profile ${p}${lbl}${a}"
                echo -e "     ${DIM}$(token_preview "$t")${NC}"
            else
                echo -e "  ${YELLOW}○${NC}  Profile $p (${label}): token missing"
            fi
        done
    fi
    echo ""
}

cmd_export() {
    local s; s=$(svc "$1"); local t; t=$(kc_read "$s")
    [[ -z "$t" ]] && { error "Profile $1 not configured."; exit 1; }
    local label; label=$(meta_get_label "$1")
    local display="$1"
    [[ -n "$label" ]] && display="$1 (${label})"
    warn "Token for profile ${display} in plain text:"; echo ""
    echo "$t" | python3 -m json.tool 2>/dev/null || echo "$t"; echo ""
}

cmd_clean() {
    warn "Remove all claude-switch entries from Keychain..."
    read -rp "Confirm? [y/N] " c; [[ ! "${c:-N}" =~ ^[Yy] ]] && { warn "Cancelled."; exit 0; }

    local profiles; profiles=$(meta_profiles)
    if [[ -n "$profiles" ]]; then
        for p in $profiles; do
            local s; s=$(svc "$p")
            [[ -n "$(kc_read "$s")" ]] && { kc_delete "$s"; ok "Deleted: $s"; }
        done
    else
        # clean legacy entries
        for p in 1 2; do
            local s; s=$(svc "$p")
            [[ -n "$(kc_read "$s")" ]] && { kc_delete "$s"; ok "Deleted: $s"; }
        done
    fi

    [[ -n "$(kc_read "$META_SERVICE")" ]] && { kc_delete "$META_SERVICE"; ok "Deleted: ${META_SERVICE}"; }
    info "Claude Code entry (${CC_SERVICE}) was not touched."
}

cmd_help() {
    echo ""
    echo "${CYAN}claude-switch${NC} — Unlimited Claude Code profiles, 1 Mac"
    echo "${DIM}Everything in the Keychain, nothing on disk.${NC}"
    echo ""
    echo "  claude-switch setup [N]        Capture current token (auto-assigns N if omitted)"
    echo "  claude-switch N [args...]      Launch Claude Code with profile N"
    echo "  claude-switch status           Profile status"
    echo "  claude-switch export N         Display a token"
    echo "  claude-switch clean            Clean up Keychain"
    echo ""
    echo "Setup:"
    echo "  claude → /login account-A → quit → claude-switch setup       # auto-assigns 1"
    echo "  claude → /login account-B → quit → claude-switch setup       # auto-assigns 2"
    echo "  claude → /login account-C → quit → claude-switch setup 5     # explicit slot 5"
    echo ""
    echo "Usage:"
    echo "  claude-switch 1    or    claude-switch 2    or    claude-switch 5"
    echo ""
}

# --- Main ---------------------------------------------------------------------

[[ $# -lt 1 ]] && { cmd_help; exit 0; }
case "$1" in
    setup)  shift; cmd_setup "${1:-}" ;;
    status) cmd_status ;;
    export) [[ $# -lt 2 ]] && { error "Usage: claude-switch export N"; exit 1; }; cmd_export "$2" ;;
    clean)  cmd_clean ;;
    help|--help|-h) cmd_help ;;
    --version|-V) echo "$VERSION" ;;
    *)
        if [[ "$1" =~ ^[1-9][0-9]*$ ]]; then
            p="$1"; shift; cmd_run "$p" "$@"
        else
            error "Unknown command: $1"; cmd_help; exit 1
        fi
        ;;
esac
